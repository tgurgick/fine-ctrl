# Environment
ENVIRONMENT=development

# Secret Management
# Set to 'true' for production (uses AWS Secrets Manager)
# Set to 'false' for development (uses .env)
USE_SECRETS_MANAGER=false

# Database
DATABASE_URL=postgresql://finetune:finetune@localhost:5432/finetune

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Rate Limiting
RATE_LIMIT_ENABLED=true

# S3/MinIO Configuration (for model storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=finetune-models
S3_REGION=us-east-1

# Anthropic API (add when implementing WP-3)
# ANTHROPIC_API_KEY=sk-ant-...

# Modal Configuration (add when implementing WP-4)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Logging
LOG_LEVEL=INFO

# Security
# Max training examples per user (by plan)
MAX_FREE_TRAINING_JOBS=5
MAX_PRO_TRAINING_JOBS=50

# Cost Controls
MAX_CLAUDE_API_COST_PER_DAY_FREE=1.0
MAX_CLAUDE_API_COST_PER_DAY_PRO=10.0
