# Environment
ENVIRONMENT=development
USE_SECRETS_MANAGER=false

# Database
DATABASE_URL=postgresql://finetune:finetune_dev_password@localhost:5432/finetune

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# S3/MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=finetune-models
S3_REGION=us-east-1

# Anthropic API (required for agent service)
ANTHROPIC_API_KEY=your-anthropic-api-key
AGENT_MODEL=claude-sonnet-4-20250514

# Modal (required for training and deployment)
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret
MODAL_INFERENCE_BASE_URL=

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Security Limits
MAX_FREE_TRAINING_JOBS=5
MAX_PRO_TRAINING_JOBS=50

# Cost Controls
MAX_CLAUDE_API_COST_PER_DAY_FREE=1.0
MAX_CLAUDE_API_COST_PER_DAY_PRO=10.0
